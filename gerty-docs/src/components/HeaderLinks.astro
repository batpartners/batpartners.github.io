---
// Header: a link back to the BAT homepage, then the default social icons. (The license form is opened from the
// GERTY plugin and linked only where the old pages linked it, so it is not in the header.)
import Default from "@astrojs/starlight/components/SocialIcons.astro";

const en = Astro.locals.starlightRoute.locale === "en";
const links = [{ href: en ? "https://b-at.kr/en/" : "https://b-at.kr/", label: "BAT.Partners" }];
---

<nav class="header-links sl-flex" aria-label={en ? "BAT Partners links" : "BAT Partners 링크"}>
  {
    links.map((l) => (
      <a href={l.href} target="_blank" rel="noopener">
        {l.label}
        <svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.75">
          <path d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6" stroke-linecap="square" />
        </svg>
        <span class="sr-only">{en ? " (opens in a new tab)" : " (새 창)"}</span>
      </a>
    ))
  }
</nav>
<Default />

<style>
  .header-links {
    gap: 1.25rem;
    margin-inline-end: 0.5rem;
  }
  .header-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    white-space: nowrap;
  }
  .header-links a:hover {
    color: var(--sl-color-white);
  }
  /* The homepage link shows at every width (header, or the mobile menu below 50rem). Where the header is tight,
     the YouTube / Instagram icons after it give way instead. */
  @media (min-width: 50rem) and (max-width: 63.99rem) {
    .header-links ~ :global(a) {
      display: none;
    }
  }
</style>
