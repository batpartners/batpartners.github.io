---
// A grid of small cards, each with one or more screenshots (kept small) and a name and short text below.
// Used for the GERTY UI elements on the overview page. `big: true` lets the picture fill the card width (for a picture that must be read).
interface Shot { src: string; caption?: string }
interface Item { name: string; text: string; shots: Shot[]; big?: boolean }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<ul class="scards">
  {items.map((t) => (
    <li class:list={["card", { big: t.big }]}>
      <div class="shots">
        {t.shots.map((s) => (
          <figure>
            <img src={s.src} alt={s.caption ?? t.name} loading="lazy" />
            {s.caption && <figcaption>{s.caption}</figcaption>}
          </figure>
        ))}
      </div>
      <div class="body">
        <strong class="name">{t.name}</strong>
        <span class="text">{t.text}</span>
      </div>
    </li>
  ))}
</ul>
<style>
  .scards { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(12.5rem, 1fr)); gap: 0.75rem; }
  :global(.sl-markdown-content) .scards > li + li { margin-top: 0; }
  .card { margin: 0; display: flex; flex-direction: column; border: 1px solid var(--sl-color-hairline); border-radius: 8px; overflow: hidden; background: var(--sl-color-bg-nav); }
  .shots { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.5rem; padding: 0.75rem; background: #f3f3f3; border-bottom: 1px solid var(--sl-color-hairline); min-height: 6.5rem; }
  figure { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 0.2rem; }
  .shots img { display: block; max-width: 100%; max-height: 5.5rem; width: auto; height: auto; margin: 0; }
  .big figure { width: 100%; }
  .big .shots img { max-height: none; width: 100%; }
  figcaption { font-size: 0.7rem; color: #555; }
  .body { display: flex; flex-direction: column; gap: 0.3rem; padding: 0.6rem 0.8rem 0.75rem; }
  .name { font-size: 0.92rem; color: var(--sl-color-white); }
  .text { font-size: 0.82rem; line-height: 1.5; color: var(--sl-color-gray-3); }
</style>
