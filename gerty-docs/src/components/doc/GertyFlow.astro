---
// The GERTY work flow as a row of numbered stages joined by arrows (a column on narrow screens).
// A dot runs along the arrows, stage by stage, so the reading order is obvious; it stays still for reduced motion.
interface Link { title: string; href: string }
interface Stage { title: string; text: string; links: Link[] }
interface Props { stages: Stage[]; label?: string }
const { stages, label = "GERTY flow" } = Astro.props;
---
<ol class="gflow" aria-label={label} style={`--n:${stages.length}`}>
  {stages.map((s, i) => (
    <li class="stage" style={`--i:${i}`}>
      <span class="num">{i + 1}</span>
      <strong class="title">{s.title}</strong>
      <span class="text">{s.text}</span>
      <span class="links">
        {s.links.map((l) => <a href={l.href}>{l.title}</a>)}
      </span>
    </li>
  ))}
</ol>
<style>
  .gflow {
    list-style: none; padding: 0; margin: 1.25rem 0 0;
    display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 1.6rem;
  }
  .stage {
    position: relative; margin: 0; padding: 0.9rem 0.8rem 0.8rem;
    display: flex; flex-direction: column; gap: 0.35rem;
    border: 1px solid var(--sl-color-hairline); border-radius: 8px; background: var(--sl-color-bg-nav);
    animation: lit calc(var(--n) * 1.4s) infinite; animation-delay: calc(var(--i) * 1.4s);
  }
  /* the arrow to the next stage */
  .stage:not(:last-child)::after {
    content: ""; position: absolute; top: 50%; inset-inline-end: -1.35rem; width: 1.1rem; height: 2px;
    background: var(--sl-color-gray-4);
  }
  .stage:not(:last-child)::before {
    content: ""; position: absolute; top: calc(50% - 4px); inset-inline-end: -1.4rem;
    border: 5px solid transparent; border-inline-start: 6px solid var(--sl-color-gray-4); border-inline-end: 0;
  }
  .num {
    display: grid; place-items: center; width: 1.5rem; height: 1.5rem; border-radius: 50%;
    font-size: 0.78rem; font-weight: 700; background: var(--sl-color-accent); color: var(--sl-color-black);
  }
  .title { font-size: 0.95rem; line-height: 1.3; color: var(--sl-color-white); }
  .text { font-size: 0.8rem; line-height: 1.45; color: var(--sl-color-gray-3); }
  .links { display: flex; flex-wrap: wrap; gap: 0.25rem 0.6rem; margin-top: auto; padding-top: 0.3rem; }
  .links a { font-size: 0.78rem; font-weight: 600; color: var(--sl-color-text-accent); text-decoration: none; }
  .links a:hover { text-decoration: underline; }
  /* :global so the margin rule of Starlight's markdown content does not push stages apart */
  :global(.sl-markdown-content) .gflow > li + li { margin-top: 0; }

  @keyframes lit {
    0%, 22% { border-color: var(--sl-color-accent); box-shadow: 0 0 0 1px var(--sl-color-accent); }
    30%, 100% { border-color: var(--sl-color-hairline); box-shadow: none; }
  }
  @media (prefers-reduced-motion: reduce) { .stage { animation: none; } }

  @media (max-width: 50rem) {
    .gflow { grid-template-columns: 1fr; gap: 1.4rem; }
    .stage:not(:last-child)::after { top: auto; bottom: -1.2rem; inset-inline-end: auto; inset-inline-start: 1.45rem; width: 2px; height: 0.9rem; }
    .stage:not(:last-child)::before { top: auto; bottom: -1.35rem; inset-inline-end: auto; inset-inline-start: calc(1.45rem - 4px); border: 5px solid transparent; border-top: 6px solid var(--sl-color-gray-4); border-bottom: 0; }
  }
</style>
