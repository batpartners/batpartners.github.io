---
// The GERTY templates as a grid of cards: the template's scene, its name in the Templates menu, what it shows,
// and the components it is built around (links to their pages).
interface Link { title: string; href: string }
interface Item { img: string; name: string; text: string; links: Link[] }
interface Props { items: Item[]; linksLabel?: string }
const { items, linksLabel = "주요 컴포넌트" } = Astro.props;
---
<ul class="tgallery">
  {items.map((t, i) => (
    <li class="card">
      <img src={t.img} alt={t.name} loading="lazy" width="720" height="480" />
      <div class="body">
        <strong class="name"><span class="idx">{i}</span>{t.name}</strong>
        <span class="text">{t.text}</span>
        <span class="links">
          <span class="lbl">{linksLabel}</span>
          {t.links.map((l) => <a href={l.href}>{l.title}</a>)}
        </span>
      </div>
    </li>
  ))}
</ul>
<style>
  .tgallery {
    list-style: none; padding: 0; margin: 1.25rem 0 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr)); gap: 0.75rem;
  }
  :global(.sl-markdown-content) .tgallery > li + li { margin-top: 0; }
  /* a small picture on the left, the text on the right */
  .card { margin: 0; display: flex; border: 1px solid var(--sl-color-hairline); border-radius: 8px; overflow: hidden; background: var(--sl-color-bg-nav); }
  .card img { display: block; flex: none; width: 8.5rem; height: auto; aspect-ratio: 3 / 2; align-self: center; object-fit: cover; margin: 0.5rem 0 0.5rem 0.5rem; border-radius: 5px; }
  .body { display: flex; flex-direction: column; gap: 0.3rem; padding: 0.55rem 0.75rem 0.6rem; flex: 1; min-width: 0; }
  .name { display: flex; align-items: center; gap: 0.45rem; font-size: 0.95rem; color: var(--sl-color-white); }
  .idx { display: grid; place-items: center; width: 1.3rem; height: 1.3rem; border-radius: 4px; font-size: 0.72rem; font-weight: 700; background: var(--sl-color-gray-5); color: var(--sl-color-white); }
  .text { font-size: 0.82rem; line-height: 1.45; color: var(--sl-color-gray-3); }
  .links { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.55rem; margin-top: auto; padding-top: 0.35rem; }
  .lbl { font-size: 0.72rem; color: var(--sl-color-gray-3); }
  .links a { font-size: 0.78rem; font-weight: 600; color: var(--sl-color-text-accent); text-decoration: none; }
  .links a:hover { text-decoration: underline; }
</style>
